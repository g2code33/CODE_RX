# CODE Rx SOCIETY - Cloudflare Environment Variables
# Copy this file to .env and fill in your actual values

# Cloudflare API URL
# - Local full-stack test (recommended): leave EMPTY and run:
#     npm run build && npx wrangler pages dev dist --local --d1 DB --r2 BUCKET
#   The site + API are then served together on http://localhost:8788
# - Local dev with Vite only (frontend changes, API elsewhere):
#     VITE_API_URL=http://localhost:8788
# - Production: leave EMPTY (the API is served from /api/* on the same domain).
VITE_API_URL=

# Cloudflare R2 Storage (Optional - for file uploads)
VITE_R2_BUCKET_URL=

# Admin Email (used to seed the first admin account)
VITE_ADMIN_EMAIL=coderxsociety@gmail.com

# Telegram Channel Link
VITE_TELEGRAM_LINK=https://t.me/+EdRpfR1GTGNjM2Q0

# Feature Flags (true/false)
VITE_ENABLE_EMAIL=false
VITE_ENABLE_UPLOADS=false
VITE_ENABLE_AUTH=true
