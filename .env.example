# CODE Rx SOCIETY - Cloudflare Environment Variables
# Copy this file to .env and fill in your actual values

# Cloudflare Workers API URL
# For local development: http://localhost:8787
# For production: https://code-rx-api.your-subdomain.workers.dev
VITE_API_URL=http://localhost:8787

# Cloudflare R2 Storage (Optional - for file uploads)
VITE_R2_BUCKET_URL=https://code-rx-storage.r2.cloudflarestorage.com

# Admin Email (for notifications)
VITE_ADMIN_EMAIL=coderxsociety@gmail.com

# Telegram Channel Link
VITE_TELEGRAM_LINK=https://t.me/+EdRpfR1GTGNjM2Q0

# Feature Flags (true/false)
VITE_ENABLE_EMAIL=false
VITE_ENABLE_UPLOADS=false
VITE_ENABLE_AUTH=false
